# ==============================================================================
# simplebash-pos: Backend environment — web / cloud
# ==============================================================================
# Target: server or cloud (Docker Compose + MongoDB)
# Copy to .env: cp .env.web.example .env
#
# EVERY variable below is required. The backend has no built-in defaults: a missing or
# invalid value stops it at startup with the name of the variable. Nothing is read from
# anywhere else.
# ==============================================================================

# --- Database ---------------------------------------------------------------
# Engine: `sqlite` (one shop, a local file) or `mongodb` (a multi-tenant cloud).
DATABASE_TYPE=mongodb
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=simplebash_pos_prod

# --- Deployment shape -------------------------------------------------------
# `single` serves one shop; `multi` serves many isolated tenants (needs MongoDB).
TENANT_MODE=multi
# `development` or `production`.
APP_ENV=production

# --- Networking -------------------------------------------------------------
PORT=8080
# `0.0.0.0` lets a container or reverse proxy in; `127.0.0.1` keeps the API on loopback.
BIND_ADDR=0.0.0.0
# Browser origins (comma separated) that may call this API, e.g. https://pos.example.com.
# Empty allows no browser origin. Never `*`.
CORS_ALLOWED_ORIGINS=https://pos.example.com

# --- Authentication ---------------------------------------------------------
# At least 32 characters; generate with: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRY_HOURS=12
# Sign-in through the SimpleBash identity service: `disabled` or `enabled`. When enabled,
# IDENTITY_JWKS_URL and IDENTITY_ISSUER are required, and in `single` mode so is
# IDENTITY_TENANT_ID (the only shop whose identity tokens are accepted).
IDENTITY_AUTH=enabled
IDENTITY_JWKS_URL=https://auth.example.com/.well-known/jwks.json
IDENTITY_ISSUER=simplebash-identity
# Shop registration by the identity service: `disabled` or `enabled` (multi-tenant only).
# When enabled, PROVISION_SECRET (at least 16 characters) is required.
PROVISIONING=enabled
PROVISION_SECRET=replace_with_a_secret_of_at_least_16_characters

# --- Document server --------------------------------------------------------
DOCUMENT_SERVER_URL=http://127.0.0.1:8090
# Must match the document-server's INTERNAL_API_KEY.
DOCUMENT_SERVER_API_KEY=replace_with_a_secure_random_64_character_hex_string
GENERATED_DOCUMENTS_DIR=generated_documents

# --- Business rules and seeding --------------------------------------------
# Days after a sale within which a credit note needs no manager override.
RETURN_WINDOW_DAYS=30
# Seed reference and sample data on startup (idempotent): `true` or `false`.
AUTO_SEED=false
# The first administrator (username is always `admin`). A publicly reachable instance that auto-seeds refuses a placeholder or `admin@1234`.
SEED_ADMIN_NAME="System Administrator"
SEED_ADMIN_PASSWORD=replace_with_your_own_admin_password

# --- This installation ------------------------------------------------------
INSTALLATION_ID=inst_cloud_1
PLATFORM=cloud

# --- Rate limits (per client, token bucket: burst and refill per second) ----
RATE_LIMIT_BURST=200
RATE_LIMIT_REFILL_PER_SEC=50
RATE_LIMIT_SENSITIVE_BURST=20
RATE_LIMIT_SENSITIVE_REFILL_PER_SEC=0.5
RATE_LIMIT_LIVE_BURST=400
RATE_LIMIT_LIVE_REFILL_PER_SEC=100

# --- Logging ----------------------------------------------------------------
# A `tracing` filter directive.
LOG_FILTER=simplebash_pos_backend=info,tower_http=info,info
# `text` for people, `json` for the desktop shell.
LOG_FORMAT=json
# Bytes of each request/response body that are logged.
LOG_BODY_CAP_BYTES=32768
# SQLite statement logging: `off`, `slow` or `all`.
LOG_SQL=off
# Log request and response bodies: `true` or `false`.
LOG_HTTP_BODIES=false
