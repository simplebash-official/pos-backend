# ==============================================================================
# myrologic-pos: Backend Web Environment Configuration Example (.env.web)
# ==============================================================================
# Target: Server / Cloud deployment (Docker Compose + MongoDB)
# Copy this file to .env when developing or deploying the backend in web/server mode:
#   cp .env.web.example .env
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION (MONGODB CLUSTER)
# ==============================================================================
DATABASE_TYPE=mongodb

# MongoDB connection URI (e.g., MongoDB Atlas or remote cluster):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=myrologic_pos_prod

# SQLite URL is not used when DATABASE_TYPE=mongodb
DATABASE_URL=

# ==============================================================================
# 2. NETWORKING & SERVER SETTINGS
# ==============================================================================
PORT=8080
# Listen on all interfaces inside container/server
BIND_ADDR=0.0.0.0

# ==============================================================================
# 3. AUTHENTICATION & SECURITY (JWT)
# ==============================================================================
# Must be a secure random 64-character hex string in production (run: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRY_HOURS=12

# ==============================================================================
# 4. DOCUMENT SERVER INTEGRATION (TYPST SERVICE)
# ==============================================================================
# Internal microservice address (in Docker: http://document-server:8090, or localhost if bare-metal):
DOCUMENT_SERVER_URL=http://document-server:8090
DOCUMENT_SERVER_API_KEY=replace_with_a_secure_random_64_character_hex_string
GENERATED_DOCUMENTS_DIR=generated_documents

# ==============================================================================
# 5. BUSINESS RULES & SEEDING AUTOMATION
# ==============================================================================
RETURN_WINDOW_DAYS=30
AUTO_SEED=true

# Optional: Override default admin account credentials created on first boot:
SEED_ADMIN_EMAIL=admin@pos.com
SEED_ADMIN_PASSWORD=admin@1234
SEED_ADMIN_NAME="System Administrator"
