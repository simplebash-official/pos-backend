# ==============================================================================
# simplebash-pos: Backend Web Environment Configuration Example (.env.web)
# ==============================================================================
# Target: Server / Cloud deployment (Docker Compose + MongoDB)
# Copy this file to .env when developing or deploying the backend in web/server mode:
#   cp .env.web.example .env
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION (MONGODB CLUSTER)
# ==============================================================================
DATABASE_TYPE=mongodb

# MongoDB connection URI (e.g., MongoDB Atlas or remote cluster):
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=simplebash_pos_prod

# SQLite URL is not used when DATABASE_TYPE=mongodb
DATABASE_URL=

# ==============================================================================
# 2. NETWORKING & SERVER SETTINGS
# ==============================================================================
PORT=8080
# Listen on all interfaces inside container/server
BIND_ADDR=0.0.0.0

# ==============================================================================
# 3. AUTHENTICATION & SECURITY (JWT)
# ==============================================================================
# Must be a secure random 64-character hex string in production (run: openssl rand -hex 32)
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string
JWT_EXPIRY_HOURS=12

# ==============================================================================
# 4. DOCUMENT SERVER INTEGRATION (TYPST SERVICE)
# ==============================================================================
# Internal microservice address (in Docker: http://document-server:8090, or localhost if bare-metal):
DOCUMENT_SERVER_URL=http://document-server:8090
DOCUMENT_SERVER_API_KEY=replace_with_a_secure_random_64_character_hex_string
GENERATED_DOCUMENTS_DIR=generated_documents

# ==============================================================================
# 5. BUSINESS RULES & SEEDING AUTOMATION
# ==============================================================================
RETURN_WINDOW_DAYS=30
AUTO_SEED=true

# Admin account created on first boot. A backend that is reachable from the
# network refuses to auto-seed until SEED_ADMIN_PASSWORD is set to your own
# value (the default `admin@1234` and these placeholders are rejected).
# The admin username is always `admin`.
SEED_ADMIN_PASSWORD=replace_with_your_own_admin_password
SEED_ADMIN_NAME="System Administrator"

# ==============================================================================
# 6. BROWSER ACCESS (CORS) & IDENTITY-SERVICE SIGN-IN
# ==============================================================================
# Origins (comma separated) whose browser pages may call this API — e.g. the
# URL your web POS is served from when it calls the API on another origin.
# Unset: single-shop mode allows only the desktop app and local Vite dev;
# multi-tenant mode allows no browser origin. Never `*`.
# CORS_ALLOWED_ORIGINS=https://pos.example.com

# Optional sign-in through the SimpleBash identity service. IDENTITY_ISSUER is
# required whenever IDENTITY_JWKS_URL is set. In TENANT_MODE=single, identity
# tokens are accepted only for the shop whose identity-service tenant id is
# IDENTITY_TENANT_ID (unset = identity tokens refused).
# IDENTITY_JWKS_URL=https://auth.example.com/.well-known/jwks.json
# IDENTITY_ISSUER=simplebash-identity
# IDENTITY_TENANT_ID=
