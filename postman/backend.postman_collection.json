{
  "info": {
    "_postman_id": "32f8d03c-bdaf-46ba-8fd5-f0be13ee0083",
    "name": "jana2u-pos backend",
    "description": "Rust/Axum API backend for jana2u-pos, a point-of-sale system for a repair/retail shop.\n\nAll requests inherit the collection-level Bearer auth (`{{accessToken}}`) \u2014 set it once per environment (Developement/Production) after obtaining a JWT. Admin-gated endpoints (inventory category/subcategory writes) additionally require the token's `role` claim to be `admin`.\n\nBase URL, and the access token, are environment variables \u2014 switch the active Postman environment to point requests at dev vs prod.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "46626151"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [],
  "variable": [
    {
      "key": "productId",
      "value": "65f1a2b3c4d5e6f7a8b9c0d1",
      "type": "string",
      "description": "Sample product ObjectId \u2014 replace with a real id from List Products."
    },
    {
      "key": "categoryKey",
      "value": "cat_xxxxxxxxxxxxxxxx",
      "type": "string",
      "description": "A category's system-generated `key` (seeded via `cargo run --bin seed_providers`) — grab a real value from the List Categories / Create Category / Valid Categories response, never the display name."
    },
    {
      "key": "subcategoryKey",
      "value": "subcat_xxxxxxxxxxxxxxxx",
      "type": "string",
      "description": "A subcategory's system-generated `key`, valid under categoryKey — grab a real value from the same responses as categoryKey, never the display name."
    }
  ],
