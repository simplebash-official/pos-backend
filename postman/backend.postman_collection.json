        {
          "name": "Products",
          "item": [
            {
              "name": "List Products",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/products?search=screen&categoryKey={{categoryKey}}&subcategoryKey={{subcategoryKey}}&lowStock=true&page=1&limit=20&sortBy=updatedAt&sortOrder=desc",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "products"
                  ],
                  "query": [
                    {
                      "key": "search",
                      "value": "screen",
                      "description": "Free-text search across name/sku/barcode",
                      "disabled": true
                    },
                    {
                      "key": "categoryKey",
                      "value": "{{categoryKey}}",
                      "description": "Filter by exact category key",
                      "disabled": true
                    },
                    {
                      "key": "subcategoryKey",
                      "value": "{{subcategoryKey}}",
                      "description": "Filter by exact subcategory key",
                      "disabled": true
                    },
                    {
                      "key": "lowStock",
                      "value": "true",
                      "description": "Only products at/below their min stock threshold",
                      "disabled": true
                    },
                    {
                      "key": "page",
                      "value": "1",
                      "description": "1-based page number"
                    },
                    {
                      "key": "limit",
                      "value": "20",
                      "description": "Page size"
                    },
                    {
                      "key": "sortBy",
                      "value": "updatedAt",
                      "description": "Whitelisted sort field",
                      "disabled": true
                    },
                    {
                      "key": "sortOrder",
                      "value": "desc",
                      "description": "asc | desc",
                      "disabled": true
                    }
                  ]
                },
                "description": "List products with search, filters, pagination and sorting."
              },
              "response": []
            },
            {
              "name": "Get Product",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/products/{{productId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "products",
                    "{{productId}}"
                  ]
                },
                "description": "Fetch a single product by its Mongo ObjectId."
              },
              "response": []
            },
            {
              "name": "Create Product",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/products",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "products"
                  ]
                },
                "description": "Create a new product. `categoryKey`/`subcategoryKey` must be a valid pair \u2014 the system-generated keys of an existing category/subcategory (see GET /categories/valid), never their display names. Prices are integer cents. `sku` is NOT sent \u2014 it's auto-generated server-side from the resolved category/subcategory names (e.g. \"PHO-SCR-0001\"); the request body has no field for it.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"barcode\": \"8901234567890\",\n  \"name\": \"iPhone 13 Screen Replacement\",\n  \"categoryKey\": \"{{categoryKey}}\",\n  \"subcategoryKey\": \"{{subcategoryKey}}\",\n  \"costPriceCents\": 450000,\n  \"sellingPriceCents\": 650000,\n  \"stockQuantity\": 10,\n  \"minStockThreshold\": 3\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": []
            },
            {
              "name": "Update Product",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/products/{{productId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "products",
                    "{{productId}}"
                  ]
                },
                "description": "Partially update a product \u2014 omit any field to leave it unchanged.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"iPhone 13 Screen Replacement (OEM)\",\n  \"sellingPriceCents\": 680000,\n  \"minStockThreshold\": 5\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": []
            },
            {
              "name": "Delete Product",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/products/{{productId}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "products",
                    "{{productId}}"
                  ]
                },
                "description": "Delete a single product by id."
              },
              "response": []
            },
            {
              "name": "Batch Delete Products",
              "request": {
                "method": "DELETE",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/products",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "products"
                  ]
                },
                "description": "Delete multiple products at once. Ids that fail to parse as ObjectId are silently skipped.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"productIds\": [\n    \"65f1a2b3c4d5e6f7a8b9c0d1\",\n    \"65f1a2b3c4d5e6f7a8b9c0d2\"\n  ]\n}",
                  "options": {
