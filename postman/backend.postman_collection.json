        {
          "name": "Categories",
          "item": [
            {
              "name": "List Categories",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/categories",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "categories"
                  ]
                },
                "description": "List all categories with their subcategories."
              },
              "response": []
            },
            {
              "name": "Create Category",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/categories",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "categories"
                  ]
                },
                "description": "Create a new top-level category with its starter subcategories (by name \u2014 each becomes its own subcategory document with a generated key). The response's `key`/`subcategories[].key` are what other requests (Create Product, Update/Delete Category, Add/Remove Subcategory) must use \u2014 copy them into the `categoryKey`/`subcategoryKey` collection variables.\n\n**Requires admin JWT** (`role: admin` claim) \u2014 inherited Bearer token must be an admin token or the API returns 403 `ADMIN_REQUIRED`.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Laptop Repairs\",\n  \"icon\": \"Laptop\",\n  \"color\": \"indigo\",\n  \"subcategories\": [\n    \"Screens\",\n    \"Keyboards\",\n    \"Batteries\"\n  ]\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": []
            },
            {
              "name": "Update Category",
              "request": {
                "method": "PUT",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/categories/{{categoryKey}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "categories",
                    "{{categoryKey}}"
                  ]
                },
                "description": "Partially update a category, looked up by its key. Renaming `name` is a pure display-label change \u2014 products reference this category by its immutable key, so nothing else needs to change.\n\n**Requires admin JWT** (`role: admin` claim) \u2014 inherited Bearer token must be an admin token or the API returns 403 `ADMIN_REQUIRED`.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"color\": \"cyan\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": []
            },
            {
              "name": "Delete Category",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/categories/{{categoryKey}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "categories",
                    "{{categoryKey}}"
                  ]
                },
                "description": "Delete a category, looked up by its key. Blocked with 409 while any product still references it; on success also deletes every subcategory under it.\n\n**Requires admin JWT** (`role: admin` claim) \u2014 inherited Bearer token must be an admin token or the API returns 403 `ADMIN_REQUIRED`."
              },
              "response": []
            },
            {
              "name": "Valid Categories",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/categories/valid",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "categories",
                    "valid"
                  ]
                },
                "description": "Category/subcategory key+name pairs (nested), for a client-side form that needs to display names while submitting `categoryKey`/`subcategoryKey` on product create/update."
              },
              "response": []
            }
          ]
        },
