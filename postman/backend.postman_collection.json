              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/categories/{{categoryKey}}/subcategories",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "categories",
                    "{{categoryKey}}",
                    "subcategories"
                  ]
                },
                "description": "Add a new subcategory to a category (looked up by its key). The response includes the new subcategory's generated `key`.\n\n**Requires admin JWT** (`role: admin` claim) \u2014 inherited Bearer token must be an admin token or the API returns 403 `ADMIN_REQUIRED`.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Cameras\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "response": []
            },
            {
              "name": "Remove Subcategory",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/api/inventory/categories/{{categoryKey}}/subcategories/{{subcategoryKey}}",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "api",
                    "inventory",
                    "categories",
                    "{{categoryKey}}",
                    "subcategories",
                    "{{subcategoryKey}}"
                  ]
                },
                "description": "Remove a subcategory (looked up by its key). Blocked with 409 while any product still references it.\n\n**Requires admin JWT** (`role: admin` claim) \u2014 inherited Bearer token must be an admin token or the API returns 403 `ADMIN_REQUIRED`."
              },
              "response": []
            }
          ]
        }
      ],
      "description": "Reference module \u2014 full product CRUD, stock adjustment/movements, and category/subcategory management."
    },
