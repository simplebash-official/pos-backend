# ==============================================================================
# jana2u-pos: Backend REST API Environment Configuration
# ==============================================================================
# Copy this file to .env and configure for local development or production:
#   cp .env.example .env
# ==============================================================================

# ==============================================================================
# 1. DATABASE CONFIGURATION (DUAL-ENGINE PERSISTENCE)
# ==============================================================================
# Persistence engine selector: 'sqlite' (local file/in-memory) or 'mongodb' (cluster).
# Defaults to 'sqlite' if unset.
DATABASE_TYPE=sqlite

# SQLite configuration (used when DATABASE_TYPE=sqlite).
# Relative paths resolve from backend root. Use mode=rwc to create if missing.
DATABASE_URL=sqlite://data/pos.db?mode=rwc

# MongoDB configuration (required only when DATABASE_TYPE=mongodb).
MONGODB_URI=mongodb://localhost:27017
# Database name in cluster: 'jana2u_pos_dev' for development, 'jana2u_pos_prod' for production.
MONGODB_DB_NAME=jana2u_pos_dev

# ==============================================================================
# 2. NETWORKING & SERVER SETTINGS
# ==============================================================================
# HTTP port the Axum server listens on. Optional, defaults to 8080.
PORT=8080

# Address the HTTP listener binds to. Optional, defaults to 0.0.0.0 (all
# interfaces) for container/reverse-proxy deployments. Set to 127.0.0.1 to
# restrict the API to loopback only (used by the Tauri desktop bundle).
BIND_ADDR=0.0.0.0

# ==============================================================================
# 3. AUTHENTICATION & SECURITY (JWT)
# ==============================================================================
# Secret key used for signing and verifying JWT HS256 tokens.
# Must be a secure random 64-character hex string in production.
JWT_SECRET=replace_with_a_secure_random_64_character_hex_string

# Single-session token lifetime in hours before re-login is required.
JWT_EXPIRY_HOURS=12

# ==============================================================================
# 4. DOCUMENT SERVER INTEGRATION (TYPST PDF PRINTING)
# ==============================================================================
# Base URL of the sibling document-server (see clients::document_server).
DOCUMENT_SERVER_URL=http://localhost:8090

# Shared secret sent as X-Internal-Api-Key to authenticate with document-server.
# Must match document-server's INTERNAL_API_KEY.
DOCUMENT_SERVER_API_KEY=replace_with_a_secure_random_64_character_hex_string

# Local filesystem directory where rendered invoice/receipt PDFs are saved (gitignored).
GENERATED_DOCUMENTS_DIR=generated_documents

# ==============================================================================
# 5. BUSINESS RULES & AUTOMATION
# ==============================================================================
# Return window in days: maximum duration after a sale to issue a credit note
# without requiring manager override authorization. Optional, defaults to 30.
RETURN_WINDOW_DAYS=30

# Automatically seed the database on startup if enabled ('true' or 'false').
# Runs all seeders idempotently in dependency order (admin, providers, suppliers, customers, inventory, api_key).
# Default admin credentials created: admin@pos.com / admin@1234.
AUTO_SEED=true
