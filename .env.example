# Database Engine: 'sqlite' (local edge POS terminal) or 'mongodb' (cloud backend)
DATABASE_TYPE=sqlite
# For SQLite: URL or file path (e.g. sqlite://data/pos.db?mode=rwc)
DATABASE_URL=sqlite://data/pos.db?mode=rwc

# For MongoDB: Same cluster URI used for both environments
MONGODB_URI=mongodb://localhost:27017
# Database name in cluster: use 'jana2u_pos_dev' for dev, 'jana2u_pos_prod' for production
MONGODB_DB_NAME=jana2u_pos_dev
JWT_SECRET=change-me-in-production
PORT=8080
JWT_EXPIRY_HOURS=12

# Sibling document-server (Typst PDF rendering) — see clients::document_server.
# DOCUMENT_SERVER_API_KEY must match that service's own INTERNAL_API_KEY.
DOCUMENT_SERVER_URL=http://localhost:8090
DOCUMENT_SERVER_API_KEY=change-me-in-production

# Where generated invoice/receipt PDFs are saved on disk (gitignored).
GENERATED_DOCUMENTS_DIR=generated_documents

# How many days after a sale a credit note may still be created against it
# without a manager override. Optional — defaults to 30 if unset.
RETURN_WINDOW_DAYS=30

# Automatically seed the database on startup (create-if-missing, idempotent)
AUTO_SEED=true
