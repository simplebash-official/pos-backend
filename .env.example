# Same cluster URI used for both environments
MONGODB_URI=mongodb://localhost:27017
# Database name in cluster: use 'jana2u_pos_dev' for dev, 'jana2u_pos_prod' for production
MONGODB_DB_NAME=jana2u_pos_dev
JWT_SECRET=change-me-in-production
PORT=8080
JWT_EXPIRY_HOURS=12

# Used only by `cargo run --bin seed_admin` to bootstrap the first Admin
# account (create-if-missing — safe to leave set permanently).
SEED_ADMIN_EMAIL=admin@jana2u.local
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME="Default Admin"
